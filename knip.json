{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/bootstrap.ts",
    "src/bootstrapApp.tsx",
    "src/**/*.worker.ts",
    "src/i18n/locales/*/index.ts",
    "src/services/perfBaseline/profilerHarness.tsx",
    "src/app-shell/assembly/useAppShellRootComposition.ts"
  ],
  "project": ["src/**/*.{ts,tsx,js,jsx}"],
  "ignore": [
    "src/test-fixtures/**",
    "src/vite-env.d.ts",
    "src/lucide-icons.d.ts"
  ],
  "ignoreDependencies": ["tailwindcss", "tw-animate-css"],
  "ignoreExportsUsedInFile": true
}
