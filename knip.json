{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/bootstrap.ts",
    "src/bootstrapApp.tsx",
    "src/**/*.worker.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "src/test-fixtures/**",
    "src/vite-env.d.ts",
    "src/lucide-icons.d.ts"
  ],
  "ignoreExportsUsedInFile": true
}
